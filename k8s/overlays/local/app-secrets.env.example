# Copie para "app-secrets.env" no mesmo diretorio e ajuste antes de aplicar o overlay.
# "app-secrets.env" esta no .gitignore (padrao "**.env") e nunca deve ser versionado. Os valores
# abaixo sao de desenvolvimento local (mesmos do docker/.env.example): substitua em qualquer
# ambiente compartilhado.
#
# TrustServerCertificate=True e deliberado: o SQL Server em container usa certificado
# autoassinado, sem CA para validar. Encrypt=True mantem o trafego cifrado; so a validacao da
# cadeia e pulada.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
RABBITMQ_DEFAULT_USER=teleseducacao
RABBITMQ_DEFAULT_PASS=TelesEduca123!
MessageQueueConnection__MessageBus=host=rabbitmq:5672;username=teleseducacao;password=TelesEduca123!;publisherConfirms=true;timeout=100
ConnectionStrings__DefaultConnection_Auth=Server=database,1433;Database=TelesEducacaoAuthDb;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true
ConnectionStrings__DefaultConnection_Alunos=Server=database,1433;Database=TelesEducacaoAlunosDb;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true
ConnectionStrings__DefaultConnection_Conteudo=Server=database,1433;Database=TelesEducacaoConteudoDb;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true
ConnectionStrings__DefaultConnection_Pagamentos=Server=database,1433;Database=TelesEducacaoPagamentosDb;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true
