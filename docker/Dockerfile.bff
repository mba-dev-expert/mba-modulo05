# ===== BUILD =====
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Propriedades MSBuild compartilhadas (TargetFramework, Nullable, TreatWarningsAsErrors...)
COPY Directory.Build.props ./

# -----------------------------
# 1. Copia csproj (cache)
# -----------------------------

# BFF
COPY src/api-gateways/TelesEducacao.Bff.Plataforma/*.csproj ./api-gateways/TelesEducacao.Bff.Plataforma/

# Building blocks (dependências comuns)
COPY src/building-blocks/TelesEducacao.Core/*.csproj ./building-blocks/TelesEducacao.Core/
COPY src/building-blocks/TelesEducacao.WebAPI.Core/*.csproj ./building-blocks/TelesEducacao.WebAPI.Core/

# -----------------------------
# 2. Restore
# -----------------------------
RUN dotnet restore ./api-gateways/TelesEducacao.Bff.Plataforma/TelesEducacao.Bff.Plataforma.csproj

# -----------------------------
# 3. Copia tudo
# -----------------------------
COPY src ./

# -----------------------------
# 4. Publish
# -----------------------------
WORKDIR /src/api-gateways/TelesEducacao.Bff.Plataforma
RUN dotnet publish -c Release -o /app/publish

# ===== RUNTIME =====
FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app/publish .

# curl: a imagem base nao traz cliente HTTP e o HEALTHCHECK precisa de um.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && adduser --disabled-password --gecos "" appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 5035
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -f http://localhost:5035/health/live || exit 1

ENTRYPOINT ["dotnet", "TelesEducacao.Bff.Plataforma.dll"]
