{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=TelesEducacaoAuth.db",
    "SqlServer": "Server=(localdb)\\mssqllocaldb;Database=TelesEducacaoAuthDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "AppTokenSettings": {
    "RefreshTokenExpiration": 8
  },
  "MessageBusResilience": {
    "PrefetchCount": 10,
    "MaxRetryAttempts": 3,
    "RetryDelaysInSeconds": [ 1, 5, 10 ],
    "ErrorQueueName": "TelesEducacao_Error_Queue",
    "ErrorExchangeName": "TelesEducacao_Error_Exchange"
  },
  "MessageQueueConnection": {
    "MessageBus": "host=localhost:5672;username=guest;password=guest;publisherConfirms=true;timeout=100"
  },
  "AllowedHosts": "*"
}
