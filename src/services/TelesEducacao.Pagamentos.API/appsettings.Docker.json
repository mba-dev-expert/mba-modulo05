{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "AutenticacaoJwksUrl": "http://auth:5101/jwks"
  },
  "MessageBusResilience": {
    "PrefetchCount": 10,
    "MaxRetryAttempts": 3,
    "RetryDelaysInSeconds": [ 1, 5, 10 ],
    "ErrorQueueName": "TelesEducacao_Error_Queue",
    "ErrorExchangeName": "TelesEducacao_Error_Exchange"
  }
}
