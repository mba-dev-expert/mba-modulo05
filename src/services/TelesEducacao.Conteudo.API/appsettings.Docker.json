{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MessageBusResilience": {
    "PrefetchCount": 10,
    "MaxRetryAttempts": 3,
    "RetryDelaysInSeconds": [ 1, 5, 10 ],
    "ErrorQueueName": "TelesEducacao_Error_Queue",
    "ErrorExchangeName": "TelesEducacao_Error_Exchange"
  },
  "AppSettings": {
    "AutenticacaoJwksUrl": "http://auth:5101/jwks"
  },
  "CorsSettings": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:4200", "http://localhost:5035" ]
  }
}
