{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=TelesEducacao_MS_Conteudo.db",
    "SqlServer": "Server=(localdb)\\mssqllocaldb;Database=TelesEducacao_MS_Conteudo;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "MessageBusResilience": {
    "PrefetchCount": 10,
    "MaxRetryAttempts": 3,
    "RetryDelaysInSeconds": [ 1, 5, 10 ],
    "ErrorQueueName": "TelesEducacao_Error_Queue",
    "ErrorExchangeName": "TelesEducacao_Error_Exchange"
  },
  "MessageQueueConnection": {
    "MessageBus": "host=localhost:5672;username=guest;password=guest;publisherConfirms=true;timeout=100"
  },
  "AppSettings": {
    "AutenticacaoJwksUrl": "https://localhost:5101/jwks"
  }
}
